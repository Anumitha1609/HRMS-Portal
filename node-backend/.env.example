# Copy this file to ".env" and fill in your real values.
# .env is gitignored — never commit real credentials.

PORT=3000

# Gmail example. You cannot use your normal Gmail password —
# you must generate a 16-character "App Password":
#   1. Turn on 2-Step Verification on the Google account
#   2. Google Account -> Security -> App Passwords
#   3. Generate one for "Mail" and paste it below
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password

# Shown as the "From" name on outgoing payslip emails
EMAIL_FROM_NAME=Eazy Design Systems HR

# Base URL of the deployed HRMS portal, used to build the
# "View / Download your payslip" link inside the email.
# Point this at your real domain once deployed; localhost is fine for dev.
HRMS_PORTAL_URL=http://localhost:4200

# Comma-separated list of origins allowed to call this API.
# Angular dev server default is http://localhost:4200
CORS_ORIGIN=http://localhost:4200
